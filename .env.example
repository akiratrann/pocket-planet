# Pocket Planet backend configuration.
# Copy to `.env` and fill in to upgrade from the zero-key heuristic engine.

# Which LLM powers extraction / summarization / self-tuning.
# One of: heuristic (default, no key) | openai | anthropic | ollama
LLM_PROVIDER=heuristic

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# Defaults to claude-opus-5. Use claude-sonnet-5 for a cheaper/faster option,
# or claude-haiku-4-5 for the cheapest (extraction quality drops).
# ANTHROPIC_MODEL=claude-opus-5

# --- Ollama, local & free (LLM_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Backend port (frontend dev proxy points here).
PORT=8787

# Scheduler (node-cron expressions). Set DISABLE_CRON=1 to turn off.
# INGEST_CRON=0 3 * * *      # re-study tracked locations daily at 03:00
# TUNE_CRON=0 */6 * * *      # self-tune every 6 hours
# DISABLE_CRON=1

# --- Community discussion mining --------------------------------------------
# Travel Stack Exchange works with NO key (300 req/day). Add a free key to raise
# the quota: https://stackapps.com/apps/oauth/register
# STACKEXCHANGE_KEY=...
#
# Reddit blocks unauthenticated access, so it's only mined when you add a free
# "script" app's credentials from https://www.reddit.com/prefs/apps
# When set, Reddit threads feed grounded opinions + the "buzz" ranking signal.
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...

# --- Security / operations -------------------------------------------------
# Who may retrain the GLOBAL ranking model (/api/train, /api/tune). Comma
# separated, matched case-insensitively against the signed-in user's email.
# UNSET MEANS NOBODY — this fails closed on purpose. The scheduled cron pass
# keeps the model fresh without any human, so leaving this empty is safe.
# ADMIN_EMAILS=you@example.com

# Browsers allowed to call the API cross-origin. Requests with no Origin
# (same-origin, curl, the PWA itself) always pass.
# ALLOWED_ORIGINS=https://pocket-planet.fly.dev,http://localhost:5173

# Rate limits, per IP. The auth limit is deliberately strict: password
# guessing is the attack it exists to stop.
# RATE_LIMIT_MAX=300            # per minute, /api/*
# AUTH_RATE_LIMIT_MAX=10        # per 15 min, login + signup

# Session lifetime. Tokens live in localStorage, so any XSS reads one — a
# shorter TTL bounds how long a stolen token is worth having.
# AUTH_TOKEN_TTL_HOURS=168      # 7 days

# Behind a proxy (Fly), trust exactly one hop of X-Forwarded-For. Without this
# every request appears to come from the edge proxy and one client's rate limit
# would lock out everybody.
# TRUST_PROXY=1
