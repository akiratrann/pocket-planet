# Pocket Planet backend configuration.
# Copy to `.env` and fill in to upgrade from the zero-key heuristic engine.

# Which LLM powers extraction / summarization / self-tuning.
# One of: heuristic (default, no key) | openai | anthropic | ollama
LLM_PROVIDER=heuristic

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Ollama, local & free (LLM_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Backend port (frontend dev proxy points here).
PORT=8787

# Scheduler (node-cron expressions). Set DISABLE_CRON=1 to turn off.
# INGEST_CRON=0 3 * * *      # re-study tracked locations daily at 03:00
# TUNE_CRON=0 */6 * * *      # self-tune every 6 hours
# DISABLE_CRON=1

# --- Community discussion mining --------------------------------------------
# Travel Stack Exchange works with NO key (300 req/day). Add a free key to raise
# the quota: https://stackapps.com/apps/oauth/register
# STACKEXCHANGE_KEY=...
#
# Reddit blocks unauthenticated access, so it's only mined when you add a free
# "script" app's credentials from https://www.reddit.com/prefs/apps
# When set, Reddit threads feed grounded opinions + the "buzz" ranking signal.
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
